class StackADT{
	int [] array;
	int max_size;
	int top ;
	
	public StackADT (int max_size) {
		this.max_size=max_size;
		this.array=new int [max_size];
		this.top=-1; // initialize the top of the stack to -1 == empty

    }
	
	public boolean isEmpty() {
        //return size == 0;
		return top==-1;
    }
    
    public boolean isFull() {
        //return size == array.length;
		return top==max_size-1;
    }
	public void push(int data){
		if (isFull()){
			System.out.println("Stack is full. cannot push"+data);
		}
		else{
			array[++top]=data;
		}
	}
	
	public void display(){
		if (isEmpty()){
			System.out.println("stack is empty.");
		}
		else {
		for (int i = top; i >= 0; i--) {
            System.out.print(array[i] + " ");
        }
        System.out.println();
	}
	}
	
	
	public int pop (){
		if (isEmpty()){
			System.out.println("stack is empty.");
			return -1; // must return something
		}
		else {
			return array[top--];
		}
	}
	


	
	public int peek(){
		if (isEmpty()){
			System.out.println("Stack is emtpy");
			return -1;
		}
		else {
			return array[top];
		}
	}
}

public class integerStack{
	public static void main (String args[]){
		StackADT stack = new StackADT(5);
		stack.push(1);
		stack.push(2);
		stack.push(3);
		stack.push(4);
		System.out.println(stack.peek());
		stack.display();
		System.out.println(stack.peek());
		stack.pop();
		stack.display();
	}
}

